---
import { getImage } from 'astro:assets';

import { SITE } from '~/config.mjs';
import { MetaSEO } from '~/types';
import { getCanonical, getAsset } from '~/utils/permalinks';
import { getRelativeUrlByFilePath } from '~/utils/directories';

import CustomStyles from '~/components/CustomStyles.astro';

export interface Props extends MetaSEO {
  dontUseTitleTemplate?: boolean;
}

const defaultImage = SITE.defaultImage
  ? (
      await getImage({
        src: SITE.defaultImage,
        width: 1200,
        height: 628,
      })
    ).src
  : '';

const {
  title = SITE.name,
  description = '',
  image: _image = defaultImage,

  canonical = getCanonical(String(Astro.url.pathname)),
  noindex = false,
  nofollow = false,

  ogTitle = title,
  ogType = 'website',

  dontUseTitleTemplate = false,
} = Astro.props;

const formattedTitle = dontUseTitleTemplate ? title : `${title} — ${SITE.name}`;

const image =
  typeof _image === 'string'
    ? new URL(_image, Astro.site)
    : _image && typeof _image['src'] !== 'undefined'
    ? // @ts-ignore
      new URL(getRelativeUrlByFilePath(_image.src), Astro.site)
    : null;

const robotsContent = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow',
].join(', ');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{formattedTitle}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={robotsContent} />
{canonical && <link rel="canonical" href={String(canonical)} />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={ogTitle} />
{description && <meta property="og:description" content={description} />}
{canonical && <meta property="og:url" content={String(canonical)} />}
{image && <meta property="og:image" content={image.toString()} />}
{image && <meta property="og:image:alt" content={ogTitle} />}

<!-- Twitter -->
{image && <meta name="twitter:card" content="summary_large_image" />}
{image && <meta name="twitter:image" content={image.toString()} />}

<CustomStyles />

<!-- Google Site Verification -->
{SITE.googleSiteVerificationId && <meta name="google-site-verification" content={SITE.googleSiteVerificationId} />}

<link rel="shortcut icon" href={getAsset('/favicon.ico')} />
<link rel="icon" type="image/svg+xml" href={getAsset('/favicon.svg')} />
<link rel="mask-icon" href={getAsset('/favicon.svg')} color="#8D46E7" />
