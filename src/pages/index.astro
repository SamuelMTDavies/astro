---
import { SITE } from '~/config.mjs';
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Content from '~/components/widgets/Content.astro';
import LatestPosts from '~/components/blog/LatestPosts.astro';

const meta = {
  title: 'UOWN - A Home For Your Money | Property Investment Made Simple',
  description: 'Invest in UK property from just £1. UOWN makes property investment accessible to everyone with proven returns and expert-backed projects.',
  dontUseTitleTemplate: true,
};
---

<Layout {meta}>

  <!-- Hero -->
  <Hero2
    callToAction={{ text: 'Start Investing', href: 'https://app.uown.co/register', icon: 'tabler:arrow-right' }}
    callToAction2={{ text: 'How It Works', href: '/how-it-works' }}
    image={{ src: import('~/assets/images/hero.png'), alt: 'UOWN Property Investment Platform' }}
  >
    <Fragment slot="title">
      A Home For <span class="text-primary">Your Money</span>
    </Fragment>

    <Fragment slot="subtitle">
      Invest in UK property developments and earn potential returns of up to 25%.
      UOWN makes property investment accessible to everyone, backed by The Parklane Group with over 45 years of experience.
    </Fragment>
  </Hero2>

  <!-- Key Stats -->
  <Stats
    items={[
      { name: 'Avg. Profit Per Project', value: '17.7%' },
      { name: 'Projects Delivered', value: '21' },
      { name: 'Platform Users', value: '16,000+' },
      { name: 'Trustpilot Rating', value: '4.9/5' },
    ]}
  />

  <!-- Why UOWN -->
  <Features
    highlight="Why UOWN?"
    title="Property investment, reimagined"
    subtitle="We examine hundreds of deals every month to bring only the best projects to our platform."
    items={[
      [
        {
          title: 'Accessible to Everyone',
          description:
            'Start investing in UK property with as little as you like. No large deposits, no mortgages, no hassle.',
          icon: 'tabler:door-enter',
        },
        {
          title: 'Expert-Backed Projects',
          description:
            'Every project is backed by The Parklane Group, with over 45 years of group experience in the UK property market.',
          icon: 'tabler:shield-check',
        },
        {
          title: 'Proven Returns',
          description:
            'An average of 17.7% profit per project. All 21 projects delivered on target since our launch in 2016.',
          icon: 'tabler:trending-up',
        },
      ],
      [
        {
          title: 'Diversified Portfolio',
          description:
            'Spread your investment across multiple projects and property types to manage risk and maximise potential returns.',
          icon: 'tabler:chart-pie',
        },
        {
          title: 'Power of the Crowd',
          description:
            'Join forces with fellow UOWNers to access large-scale projects and returns usually reserved for institutional investors.',
          icon: 'tabler:users-group',
        },
        {
          title: 'Full Transparency',
          description:
            'Track your investments in real time through our platform. Regular updates on every project, every step of the way.',
          icon: 'tabler:eye',
        },
      ],
    ]}
  />

  <!-- How It Works Preview -->
  <Steps
    title="How it works"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Sign Up</span>',
        description:
          'Create your free UOWN account in minutes. No commitment required, just sign up and start exploring investment opportunities.',
        icon: 'tabler:user-plus',
      },
      {
        title: 'Step 2: <span class="font-medium">Choose a Project</span>',
        description:
          'Browse our curated selection of property projects. Each one is backed by The Parklane Group and thoroughly vetted by our team.',
        icon: 'tabler:building',
      },
      {
        title: 'Step 3: <span class="font-medium">Invest</span>',
        description:
          'Invest the amount that suits you. Whether it\'s tens of pounds or hundreds of thousands, every investment counts.',
        icon: 'tabler:coin',
      },
      {
        title: 'Earn returns!',
        icon: 'tabler:chart-line',
      },
    ]}
    image={{
      src: import('~/assets/images/creativity.jpg'),
      alt: 'UOWN Investment Process',
    }}
  />

  <!-- Investment Types -->
  <Content
    highlight="Investment Types"
    title="Two ways to invest"
    items={[
      {
        title: 'Development Projects',
        description:
          'Targeted returns of up to 25%. Your capital plus returns are paid at the end of the project term.',
      },
      {
        title: 'Buy-to-Let Properties',
        description:
          'Earn 6%-9% annual rental income paid monthly, plus 5%-7% capital appreciation when the property is sold.',
      },
      {
        title: 'Secured Investments',
        description:
          'Many of our investments are secured by equitable charges on the underlying property, giving you added protection.',
      },
    ]}
    image={{
      src: import('~/assets/images/caos.jpg'),
      alt: 'Investment Types',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Built on experience</h3>
      Built upon a foundation of tireless analysis, stress testing and time-served sector experience, we examine hundreds of deals
      every month to bring only the best projects to our platform.
    </Fragment>
  </Content>

  <!-- Social Proof -->
  <Features2
    title="What our investors say"
    subtitle="Don't just take our word for it. 8 out of 10 users go on to make multiple investments."
    highlight="Testimonials"
    items={[
      {
        title: '"Never let me down"',
        description:
          'I have been investing with UOWN for several years now and they have never let me down. I have had good returns on my investments in line with what was projected.',
        icon: 'tabler:star',
      },
      {
        title: '"The only one that delivered"',
        description:
          'I have trial investments with seven property crowdfunding platforms. UOWN is the only one that has delivered on time and on budget.',
        icon: 'tabler:trophy',
      },
      {
        title: '"Transparent and reliable"',
        description:
          'Great platform with regular updates. The team are responsive and always happy to answer questions. Highly recommended.',
        icon: 'tabler:message-circle',
      },
    ]}
  />

  <!-- Latest from The Hub -->
  <LatestPosts
    title="Latest from The Hub"
    information="Stay up to date with property market insights, investment tips, and UOWN news."
    postIds={[
      'get-started-website-with-astro-tailwind-css.md',
      'how-to-customize-astrowind-to-your-brand.md',
      'useful-resources-to-create-websites.md',
      'astrowind-template-in-depth.md',
    ]}
  />

  <!-- CTA -->
  <CallToAction
    callToAction={{
      text: 'Start Investing Today',
      href: 'https://app.uown.co/register',
      icon: 'tabler:arrow-right',
    }}
  >
    <Fragment slot="title">
      Ready to become a <span class="sm:whitespace-nowrap">property investor?</span>
    </Fragment>

    <Fragment slot="subtitle">
      Join 16,000+ UOWNers already investing in UK property.
      Sign up for free and explore our current opportunities.
    </Fragment>
  </CallToAction>
</Layout>
