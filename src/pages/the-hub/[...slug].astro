---
export async function getStaticPaths() {
  try {
    const { useStoryblokApi } = await import('@storyblok/astro');
    const sbApi = useStoryblokApi();
    const { data } = await sbApi.get("cdn/stories", {
      content_type: "HubPost",
      version: import.meta.env.DEV ? "draft" : "published",
      starts_with: "the-hub-new/"
    });
    return data.stories.map((story) => ({
      params: { slug: story.slug },
    }));
  } catch (e) {
    // Storyblok not configured, return no pages
    return [];
  }
}

let story = null;
try {
  const { useStoryblokApi } = await import('@storyblok/astro');
  const sbApi = useStoryblokApi();
  const { slug } = Astro.params;
  const { data } = await sbApi.get(`cdn/stories/the-hub-new/${slug}`, {
    version: import.meta.env.DEV ? "draft" : "published",
  });
  story = data.story;
} catch (e) {
  // Storyblok not configured
}
---
<html lang="en">
  <head>
    <title>Storyblok & Astro</title>
  </head>
  <body>
    {story ? (
      <p>Storyblok content loaded.</p>
    ) : (
      <p>Storyblok is not configured.</p>
    )}
  </body>
</html>
